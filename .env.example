# Palast environment variables
# Copy to .env and fill in. Never commit .env.

# Supabase project URL (https://xxxxx.supabase.co)
SUPABASE_URL=

# Supabase anon (public) key
SUPABASE_ANON_KEY=

# PostHog project API key (client-side)
POSTHOG_API_KEY=

# Sentry DSN
SENTRY_DSN=

# --- Server-side only (set as Supabase Edge Function secrets, NEVER ship to client) ---
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
